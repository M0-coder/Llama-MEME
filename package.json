{
  "name": "llama-meme",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical engineering repository for the Llama (LLAMA) Solana meme-token project.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-check.mjs",
    "lint": "node --check scripts/*.mjs && node --check tests/*.mjs",
    "validate": "node scripts/validate-token-spec.mjs && node scripts/verify-assets-manifest.mjs",
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "security": "node scripts/security-check.mjs",
    "ci": "npm run build && npm run lint && npm run validate && npm test && npm run security"
  }
}
